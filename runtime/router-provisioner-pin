#!/bin/ash
# Priority failover for NetShift selector groups.
#
# sing-box has no priority-ordered outbound group: urltest always picks the
# fastest node, and a selector never fails over on its own. This helper keeps
# each group pinned to its primary node and moves to the reserve only while the
# primary is actually down, then moves back as soon as it answers again.
#
# Groups are described in PINNED_FILE, one per line:
#     <selector group>|<primary keyword>|<reserve keyword>
# Keywords are matched against the node names the group actually offers, so the
# operator never has to type emoji or the exact node name.
set -u

TAG='router-provisioner-pin'
PINNED_FILE='/etc/router-provisioner/pinned'
STATE_FILE='/tmp/router-provisioner-pin.state'
SING_BOX_CONFIG='/etc/sing-box/config.json'
TEST_URL='https://www.gstatic.com/generate_204'
TIMEOUT=5000
LOCK='/tmp/router-provisioner-pin.lock'

# Switching a selector closes every connection that was using the old node, and
# the service on the other end sees a new exit address. That is the whole cost
# of a failover, and it is only worth paying when the primary is really gone.
#
# A single probe is not evidence. Twice in one day the primary failed one check
# and answered again 55 seconds later; both times the switch away and the switch
# back cost a signed-in session - connections 83 minutes old, closed for a blip
# that TCP would have ridden out.
#
# Waiting three cron minutes would fix that and leave a real outage unhandled
# for three minutes, which is its own kind of broken. So the evidence is
# gathered densely instead of slowly: on the first miss, keep asking every two
# seconds. A blip answers on the second or third try and nothing moves; a dead
# node stays silent through the whole burst.
#
# Measured on the router: a failing probe comes back at once when the node
# refuses, and waits out BURST_TIMEOUT when it swallows the packet, so a real
# outage is confirmed in fifteen to forty seconds. A healthy node answers on the
# first try and the whole run costs nothing.
#
# The line this draws: silence longer than about forty seconds counts as an
# outage and will move the node, sessions and all. Shorter than that is ridden
# out.
BURST_PROBES=8
BURST_TIMEOUT=3000
BURST_GAP=2

# Checks that are not about to close anyone's connections stay cheap.
QUICK_PROBES=2

# The return trip kills sessions exactly like the outbound one, and nothing is
# broken while it waits, so it stays lazy.
RECOVER_THRESHOLD=5

log() {
    logger -t "$TAG" "$*"
}

cleanup() {
    rmdir "$LOCK" 2>/dev/null || true
}

trap cleanup 0 HUP INT TERM

[ -s "$PINNED_FILE" ] || exit 0
command -v curl >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

mkdir "$LOCK" 2>/dev/null || exit 0

# The Clash API binds to whatever external_controller says - usually the LAN
# address, not loopback. Read it from the generated config rather than guessing:
# uci returns the LAN address with its CIDR suffix, which builds a broken URL.
# The body check matters too, because port 80 answers with the web UI and would
# otherwise look like a healthy API.
api_base() {
    controller=$(jq -r '.experimental.clash_api.external_controller // empty' \
        "$SING_BOX_CONFIG" 2>/dev/null)

    for candidate in "$controller" '127.0.0.1:9090'; do
        [ -n "$candidate" ] || continue

        if curl -s -m 3 "http://$candidate/version" 2>/dev/null | \
            grep -q '"version"'; then
            printf 'http://%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

# This BusyBox has no od, and the Clash API accepts raw UTF-8 in a path.
# Only spaces actually need escaping.
urlencode() {
    printf '%s' "$1" | sed 's/ /%20/g'
}

api_get() {
    curl -s -m 5 "$1/proxies/$(urlencode "$2")" 2>/dev/null
}

# Resolve a keyword to a node the group really offers, skipping the group's own
# urltest entry so a keyword can never select the automatic group by accident.
resolve_node() {
    base=$1
    group=$2
    keyword=$3

    [ -n "$keyword" ] || return 1

    # endswith, not test: OpenWrt's jq is built without Oniguruma, so every
    # regex builtin errors out and the whole filter silently yields nothing.
    api_get "$base" "$group" | \
        jq -r --arg kw "$keyword" \
            '.all[]? | select(endswith("-urltest-out") | not) | select(contains($kw))' \
        2>/dev/null | head -n 1
}

probe_once() {
    curl -s -m 12 -G \
        "$1/proxies/$(urlencode "$2")/delay" \
        --data "timeout=$3" \
        --data-urlencode "url=$TEST_URL" \
        2>/dev/null | jq -r '.delay // empty' 2>/dev/null
}

# Ask up to <attempts> times, stopping at the first answer. A healthy node
# answers on the first try in a fifth of a second, so the burst only costs
# anything when something is actually wrong.
node_answers() {
    _pa_base=$1
    _pa_node=$2
    _pa_attempts=$3
    _pa_timeout=$4
    _pa_gap=$5
    _pa_try=0

    while [ "$_pa_try" -lt "$_pa_attempts" ]; do
        _pa_try=$((_pa_try + 1))

        delay=$(probe_once "$_pa_base" "$_pa_node" "$_pa_timeout")
        if [ -n "$delay" ] && [ "$delay" -gt 0 ] 2>/dev/null; then
            PROBE_TRIES=$_pa_try
            return 0
        fi

        [ "$_pa_try" -lt "$_pa_attempts" ] && [ "$_pa_gap" -gt 0 ] && \
            sleep "$_pa_gap"
    done

    PROBE_TRIES=$_pa_try
    return 1
}

# Counters survive between cron runs; losing them on reboot is harmless, since
# a fresh boot starts from the primary anyway.
state_field() {
    grep "^$1|" "$STATE_FILE" 2>/dev/null | head -n 1 | cut -d'|' -f"$2"
}

state_store() {
    _state_tmp="$STATE_FILE.$$"
    grep -v "^$1|" "$STATE_FILE" 2>/dev/null > "$_state_tmp" || true
    printf '%s|%s|%s\n' "$1" "$2" "$3" >> "$_state_tmp"
    mv "$_state_tmp" "$STATE_FILE"
}

current_node() {
    api_get "$1" "$2" | jq -r '.now // empty' 2>/dev/null
}

select_node() {
    curl -s -m 5 -o /dev/null -X PUT \
        -H 'Content-Type: application/json' \
        --data "$(jq -n --arg name "$3" '{name: $name}')" \
        "$1/proxies/$(urlencode "$2")" 2>/dev/null
}

PROBE_TRIES=0

BASE=$(api_base) || exit 0

grep -v '^[[:space:]]*#' "$PINNED_FILE" | \
    while IFS='|' read -r group primary_keyword reserve_keyword; do
        [ -n "$group" ] || continue

        now=$(current_node "$BASE" "$group")
        [ -n "$now" ] || continue

        primary=$(resolve_node "$BASE" "$group" "$primary_keyword")
        if [ -z "$primary" ]; then
            log "$group: no node matches '$primary_keyword', leaving it alone"
            continue
        fi

        oks=$(state_field "$group" 3)
        [ -n "$oks" ] || oks=0

        # On the reserve already: nothing is at stake in this check, so keep it
        # cheap and let RECOVER_THRESHOLD do the deciding.
        if [ "$now" != "$primary" ]; then
            if node_answers "$BASE" "$primary" "$QUICK_PROBES" "$TIMEOUT" 1; then
                oks=$((oks + 1))
                if [ "$oks" -ge "$RECOVER_THRESHOLD" ]; then
                    select_node "$BASE" "$group" "$primary"
                    log "$group: primary steady for $oks checks, switched back to $primary"
                    oks=0
                fi
            else
                oks=0
            fi

            state_store "$group" 0 "$oks"
            continue
        fi

        # On the primary. A miss here is about to cost every connection on it,
        # so keep asking for about forty seconds before believing it.
        if node_answers "$BASE" "$primary" "$BURST_PROBES" "$BURST_TIMEOUT" \
            "$BURST_GAP"; then
            [ "$PROBE_TRIES" -gt 1 ] && \
                log "$group: primary missed $((PROBE_TRIES - 1)), answered on try $PROBE_TRIES, staying"
            state_store "$group" 0 0
            continue
        fi

        reserve=$(resolve_node "$BASE" "$group" "$reserve_keyword")
        if [ -z "$reserve" ]; then
            log "$group: primary is down and no reserve is configured"
            state_store "$group" 0 0
            continue
        fi

        # If the reserve is silent too, the uplink is down, not the node -
        # switching would cost every connection and fix nothing.
        if node_answers "$BASE" "$reserve" "$QUICK_PROBES" "$TIMEOUT" 1; then
            select_node "$BASE" "$group" "$reserve"
            log "$group: primary silent for $PROBE_TRIES probes, switched to $reserve"
        else
            log "$group: primary and reserve are both silent, staying put"
        fi

        state_store "$group" 0 0
    done

exit 0
