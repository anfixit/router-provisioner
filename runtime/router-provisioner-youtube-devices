#!/bin/ash
# Sends YouTube of chosen devices through the tunnel instead of the direct
# route.
#
# YouTube normally goes direct (YT_DIRECT, /etc/netshift/rulesets/
# direct-route.lst) with youtubeUnblock hiding the ClientHello from DPI. A
# device the bypass does not carry gets no YouTube at all: on 2026-11-07 the
# Yandex Module TV box (TLS 1.2, 206-byte ClientHello) got 0 bytes back on every
# connection while splitting alone was configured. A fake ClientHello
# (fake_sni=1, lib/youtubeunblock.sh) fixed that case the next day, so this is
# the fallback for whatever the bypass still cannot carry. The price is the
# exit country: YouTube then answers in its language and shows its ads, which
# Google does not sell into Russia.
#
# Devices like that are listed one per line in $DEVICES_FILE, by MAC address
# (preferred: it survives a new DHCP lease) or by IPv4 address/subnet; `#`
# starts a comment. Their YouTube is routed to $OUTBOUND ahead of every section
# rule. Everything else they do keeps its usual route, which matters for a
# Yandex box: Kinopoisk and the rest of Yandex must stay on the Russian address.
#
# Reads a sing-box config on stdin and prints it back with the rules added.
# Called from NetShift's config generator (see router-provisioner-netshift-
# patch), so it never fails the generator: on any problem the config is printed
# back unchanged.
set -u

TAG='router-provisioner-youtube-devices'
DEVICES_FILE=${DEVICES_FILE:-/etc/router-provisioner/youtube-via-vpn}
OUTBOUND=${OUTBOUND:-VPN-out}
# The YouTube part of direct-route.lst (lib/netshift.sh).
DOMAINS='googlevideo.com ytimg.com ggpht.com yt3.googleusercontent.com youtube.com youtu.be jnn-pa.googleapis.com'

log() {
    logger -t "$TAG" "$*" 2>/dev/null || true
}

input=$(cat)

unchanged() {
    printf '%s\n' "$input"
    exit 0
}

[ -s "$DEVICES_FILE" ] || unchanged

macs=''
addresses=''
while IFS= read -r line || [ -n "$line" ]; do
    entry=$(printf '%s' "${line%%#*}" | tr -d ' \t\r' | tr 'A-F' 'a-f')
    [ -n "$entry" ] || continue

    if printf '%s' "$entry" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
        macs="$macs $entry"
    elif printf '%s' "$entry" | \
        grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$'; then
        addresses="$addresses $entry"
    else
        # One bad line must not cost the other devices their rule, nor give
        # sing-box a value it rejects - that would stop NetShift from starting.
        log "skipping '$entry' in $DEVICES_FILE: not a MAC or IPv4 address"
    fi
done < "$DEVICES_FILE"

[ -n "$macs$addresses" ] || unchanged

output=$(printf '%s' "$input" | jq -c \
    --arg outbound "$OUTBOUND" \
    --arg macs "$macs" \
    --arg addresses "$addresses" \
    --arg domains "$DOMAINS" '
    def words: split(" ") | map(select(length > 0));
    ($macs | words) as $macs
    | ($addresses | words) as $addresses
    | ($domains | words) as $domains
    # The section rules are the ones built from rule-sets; YT_DIRECT is among
    # them, so the device rules go ahead of the first one.
    | ((.route.rules // []) | map(has("rule_set")) | index(true)) as $at
    | if ([.outbounds[]?.tag] | index($outbound)) == null or $at == null then
        error("no \($outbound) outbound or no section rules")
      else
        (.route.rules[$at].inbound) as $inbound
        | def rule($match): {action: "route", inbound: $inbound}
            + $match + {domain_suffix: $domains, outbound: $outbound};
        [ (if ($addresses | length) > 0 then rule({source_ip_cidr: $addresses}) else empty end),
          (if ($macs | length) > 0 then rule({source_mac_address: $macs}) else empty end)
        ] as $device_rules
        | .route.rules |= (.[:$at] + $device_rules + .[$at:])
        # sing-box learns the MAC of a connection from the neighbour table
        # only when asked to.
        | if ($macs | length) > 0 then .route.find_neighbor = true else . end
      end
    ' 2>/dev/null) || {
    log "config left as it was: no $OUTBOUND outbound or no section rules"
    unchanged
}

[ -n "$output" ] || unchanged
printf '%s\n' "$output"
