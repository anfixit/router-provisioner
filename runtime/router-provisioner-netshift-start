#!/bin/ash
set -u

TAG='router-provisioner-boot'
LOCK='/tmp/router-provisioner-netshift-start.lock'
MAX_WAN_WAIT=240
MAX_READY_ATTEMPTS=45
PROBE_DOMAINS='discord.com x.com web.telegram.org rutracker.org instagram.com youtube.com'

log() {
    logger -t "$TAG" "$*"
}

cleanup() {
    rmdir "$LOCK" 2>/dev/null || true
}

trap cleanup 0 HUP INT TERM

mkdir "$LOCK" 2>/dev/null || {
    log 'another startup is already running'
    exit 0
}

# No subscription means no proxy outbound. Starting NetShift would repoint
# dnsmasq at a resolver that answers nothing and take the LAN offline, so wait
# for the user to add a subscription in LuCI instead.
if ! uci -q get netshift.VPN.subscription_url >/dev/null 2>&1; then
    log 'no subscription configured; leaving NetShift stopped'
    exit 0
fi

# The uplink may be a Wi-Fi client, wwan or pppoe, so never assume an
# interface named "wan". A default route alone proves nothing either: early in
# boot it can point at the LAN bridge before the real uplink is configured.
# Readiness therefore means the ruleset actually downloads, which proves route,
# DNS and reachability at once.
wait_for_uplink() {
    elapsed=0
    reported=''

    while [ "$elapsed" -lt "$MAX_WAN_WAIT" ]; do
        device=$(ip route show default 2>/dev/null | \
            awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')

        if [ -n "$device" ]; then
            if [ "$device" != "$reported" ]; then
                log "default route is via $device, verifying reachability"
                reported=$device
            fi

            if uplink_reachable; then
                log "uplink device is $device"
                return 0
            fi
        fi

        sleep 5
        elapsed=$((elapsed + 5))
    done

    return 1
}

# Reachability must be proved without DNS. The previous version downloaded a
# ruleset from GitHub, and once objects.githubusercontent.com was routed through
# the proxy - which is what makes the list update work at all - the name started
# resolving to a FakeIP address. The router's own traffic does not go through
# tproxy, so that address leads nowhere and the check failed every single time
# NetShift was running, which is exactly when it runs. The helper then did as it
# was told and stopped a perfectly healthy service.
#
# Literal addresses cannot be captured by FakeIP. Any one of them answering is
# enough: the question here is only "is there a way out", not "is the whole
# internet well".
uplink_reachable() {
    gateway=$(ip route show default 2>/dev/null | \
        awk '{for (i = 1; i < NF; i++) if ($i == "via") {print $(i + 1); exit}}')

    for target in "$gateway" 77.88.8.8 1.1.1.1 8.8.8.8; do
        [ -n "$target" ] || continue
        ping -c 1 -W 2 "$target" >/dev/null 2>&1 && return 0
    done

    # ICMP is filtered on some uplinks; a TCP handshake to a literal address
    # settles it without asking a resolver anything.
    for target in 77.88.8.8 1.1.1.1; do
        if command -v uclient-fetch >/dev/null 2>&1; then
            uclient-fetch -q -T 4 -O /dev/null "http://$target/" 2>/dev/null && \
                return 0
        elif command -v wget >/dev/null 2>&1; then
            wget -q -T 4 -O /dev/null "http://$target/" 2>/dev/null && return 0
        fi
    done

    return 1
}

# Which domains get a FakeIP depends entirely on the routing topology: with a
# global proxy NetShift marks everything in nftables and hands FakeIP only to
# the excluded lists, so demanding a 198.18.x answer for a chosen domain fails
# on a perfectly healthy router. What always holds is that sing-box answers DNS
# at all once it is up, so that is the readiness signal.
resolver_answers() {
    for domain in $PROBE_DOMAINS; do
        if nslookup "$domain" 127.0.0.42 2>/dev/null | \
            grep -Eq '^Address: *[0-9]'; then
            return 0
        fi
    done

    return 1
}

# Marked packets reach sing-box only through a policy routing rule. Anything
# that reloads the network - "/etc/init.d/network restart", a firewall reload -
# drops that rule while leaving the nftables table, the tproxy rules and the
# process itself untouched. Every surface check then looks healthy while no
# proxied site opens, so check the rule explicitly.
policy_route_present() {
    ip rule show 2>/dev/null | grep -q 'lookup netshift'
}

service_ready() {
    pgrep -f '[s]ing-box run' >/dev/null 2>&1 || return 1
    [ -s /etc/sing-box/config.json ] || return 1
    /usr/bin/sing-box check -c /etc/sing-box/config.json \
        >/dev/null 2>&1 || return 1
    policy_route_present || return 1
    resolver_answers
}

wait_for_service() {
    attempt=0

    while [ "$attempt" -lt "$MAX_READY_ATTEMPTS" ]; do
        service_ready && return 0
        sleep 2
        attempt=$((attempt + 1))
    done

    return 1
}

# Plain restart, nothing else. NetShift's own start downloads the lists and
# writes the local rule-set files under /tmp/sing-box/rulesets. Stopping it
# again after a list_update wipes those files, and the next start skips
# regenerating them because it sees an unchanged config hash - sing-box then
# dies on "parse rule-set: no such file or directory".
attempt_start() {
    /etc/init.d/netshift restart >/dev/null 2>&1 || true
    wait_for_service
}


# Selector choices live in sing-box memory and its cache sits in tmpfs, so a
# reboot always resets pinned groups to the automatic urltest. Re-pin them now
# instead of waiting up to a minute for the cron helper.
restore_pinned_nodes() {
    [ -x /usr/bin/router-provisioner-pin ] || return 0
    /usr/bin/router-provisioner-pin >/dev/null 2>&1 || true
}

# NetShift hardcodes when it updates: 09:13 for lists, 09:17 for subscriptions.
# Those times cannot be moved through its configuration, and it rewrites the
# crontab on every start, so they have to be corrected afterwards. It matters
# because each update restarts sing-box, and a restart drops the pinned node
# for a few seconds - long enough for a service to see a new exit address and
# demand a fresh login. Middle of the working day is the worst moment for that.
# The subscription line goes away entirely: the refresh helper already updates
# subscriptions nightly and can roll back, which NetShift's own job cannot.
retime_netshift_cron() {
    [ -f /etc/crontabs/root ] || return 0

    corrected="/tmp/router-provisioner-cron.$$"
    grep -v '/usr/bin/netshift subscription_update' /etc/crontabs/root | \
        sed 's|^.*/usr/bin/netshift list_update *$|30 3 * * * /usr/bin/netshift list_update|' \
        > "$corrected" 2>/dev/null || {
        rm -f "$corrected"
        return 0
    }

    if ! cmp -s "$corrected" /etc/crontabs/root; then
        cat "$corrected" > /etc/crontabs/root
        chmod 600 /etc/crontabs/root
        /etc/init.d/cron restart >/dev/null 2>&1 || true
        log 'netshift update schedule moved to the small hours'
    fi

    rm -f "$corrected"
}

if ! wait_for_uplink; then
    log 'uplink not reachable after 240 seconds'

    # Stopping exists for the boot case, where a half-started NetShift can take
    # DNS and routing down with it. It must never be the answer for a service
    # that is up and working: a probe that disagrees with a healthy service is
    # a broken probe, and killing the service turns a false alarm into fifteen
    # hours without a VPN.
    if service_ready; then
        log 'but NetShift is healthy, leaving it alone'
        retime_netshift_cron
        restore_pinned_nodes
        exit 0
    fi

    log 'and NetShift is not healthy either; stopping it to restore ordinary DNS and routing'
    /etc/init.d/netshift stop >/dev/null 2>&1 || true
    exit 1
fi

if attempt_start; then
    log 'NetShift is ready'
    retime_netshift_cron
    restore_pinned_nodes
    exit 0
fi

log 'first start failed; retrying once'
if attempt_start; then
    log 'NetShift recovered on the second attempt'
    retime_netshift_cron
    restore_pinned_nodes
    exit 0
fi

log 'NetShift failed twice; stopping it to restore ordinary DNS and routing'
logread -e netshift -e sing-box | tail -n 80 | \
    while IFS= read -r line; do
        log "diagnostic: $line"
    done
/etc/init.d/netshift stop >/dev/null 2>&1 || true
exit 1
