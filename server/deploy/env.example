# Copy to .env (chmod 600) next to compose.yaml.
HUB_KEY=
HUB_DOMAIN=
HUB_PUBLIC_IP=
# Password hash for the hub page (empty = page disabled). Get it with:
#   python3 router-hub.py --hash-password
# or in the stack directory:
#   docker compose run --rm -it hub python3 -I /app/router-hub.py --hash-password
# The hash contains "$", which docker compose interpolates in unquoted values:
# wrap it in single quotes.
HUB_ADMIN_PASSWORD_HASH=
