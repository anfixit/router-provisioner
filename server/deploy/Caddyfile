{
	auto_https disable_redirects
}

{$HUB_DOMAIN}:443 {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# The hub key travels in the query string; it must never reach the log.
	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 720h
		}
		format filter {
			request>uri query {
				delete key
			}
			request>headers delete
		}
	}

	request_body {
		max_size 9MB
	}

	# Prometheus-style counters are for the box itself; the proxy must not
	# hand them to the internet. Matched before the catch-all proxy below.
	@metrics path /hub/metrics /hub/metrics/*
	handle @metrics {
		respond 404
	}

	# Browsers ask for it even when the page has a data: icon; an unanswered
	# request would hit the catch-all 404 and count against the visitor.
	handle /favicon.ico {
		respond 204
	}

	# The page uses relative URLs, so it needs the trailing slash.
	redir /hub /hub/ 308

	handle_path /hub/* {
		reverse_proxy hub:9095
	}

	handle {
		respond 404
	}
}
