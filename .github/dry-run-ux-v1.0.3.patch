+test_dry_run_final_summary() {
+    DRY_RUN=1
+
+    output=$(print_final_instructions 2>&1)
+
+    assert_contains "$output" 'Предварительный просмотр завершён' \
+        'dry-run must not claim that provisioning is complete'
+    assert_contains "$output" 'NetShift не устанавливался' \
+        'dry-run must explicitly report that NetShift was not installed'
+    assert_not_contains "$output" '/etc/init.d/dropbear restart' \
+        'dry-run must not request a Dropbear restart'
